# Wumbi — Hostinger serves the repo root as the document root, but the built
# site lives in wumbi_landing/dist. Route every request there and hide the rest
# of the repository (Flutter sources, docs, package.json, .git…).

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Already inside the built site → serve as-is.
  RewriteCond %{REQUEST_URI} ^/wumbi_landing/dist/ [NC]
  RewriteRule ^ - [L]

  # Everything else → same path inside wumbi_landing/dist ("/" → dist/index.html).
  RewriteRule ^(.*)$ /wumbi_landing/dist/$1 [L]
</IfModule>

# Never expose VCS metadata or dotfiles even if rewriting is unavailable.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.(git|htaccess|env|thumbnail)
</IfModule>

# Cache static assets; HTML stays revalidated so deploys show up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
