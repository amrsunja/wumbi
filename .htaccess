# Wumbi — Apache front door.
#
# The document root is the REPOSITORY ROOT (Hostinger's Git deploy publishes the
# whole repo), while the built site lives in wumbi_landing/dist. Every public URL
# is mapped into that directory at the bottom of this file.
#
# Two kinds of rule live here; do not mix them up:
#
#   * front-door rules (1-3) are guarded by %{THE_REQUEST}. THE_REQUEST holds the
#     original request line ("GET /ru/ HTTP/1.1") and is NOT rewritten by internal
#     redirects, so these rules fire only for what the client literally asked for.
#     That is what makes them loop-proof once rule 5 has mapped the URL into
#     wumbi_landing/dist/.
#   * mapping rules (4-5) run on every pass.
#
# Do NOT protect repo sources here with <FilesMatch>/Require: non-rewrite
# directives merge down into subdirectories and would also apply to dist/.
#
# mod_rewrite does not inherit parent rules into a directory that has its own
# .htaccess with RewriteEngine On — that is why dist/.htaccess must stay
# self-sufficient (it is generated from wumbi_landing/htaccess.src).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 1. Canonical host: https, no www, in a single hop.
  # MUST live here, not in dist/.htaccess: by the time dist/.htaccess runs, the
  # URL has already been rewritten to /wumbi_landing/dist/..., and a host
  # redirect built from %{REQUEST_URI} there would hand Google the internal path.
  # That is how /wumbi_landing/dist/ got indexed in the first place.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://wumbi.app/$1 [L,R=301,NE]

  # --- 2. The duplicate: /wumbi_landing/dist/<path> -> /<path>, 301.
  # %1 comes from the RewriteCond capture, so the whole sub-path is carried over
  # (/wumbi_landing/dist/ru/ -> /ru/) and the bare directory lands on /.
  RewriteCond %{THE_REQUEST} \s/+wumbi_landing/dist/?([^\s?]*)[\s?] [NC]
  RewriteRule ^ https://wumbi.app/%1 [L,R=301,NE]

  # --- 3. Everything else that belongs to the repository: 410 Gone.
  # 410 (not 404) so Google drops these from the index quickly.
  # REDIRECT_STATUS is empty on the client's request and set on the internal
  # ErrorDocument pass — without it the 410 page would 410 itself and Apache
  # would serve its bare default body instead of /404.html.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{THE_REQUEST} \s/+(wumbi_landing|wumbi_app|docs|node_modules|package\.json|package-lock\.json|\.git|\.github|\.idea|\.dart_tool|\.metadata)([/\s?]|$) [NC]
  RewriteRule ^ - [G,L]

  # --- 4. Already inside the build output: serve it, never map twice.
  RewriteRule ^wumbi_landing/dist/ - [L]

  # --- 5. Map the public URL space onto the build output.
  RewriteRule ^(.*)$ /wumbi_landing/dist/$1 [L]
</IfModule>

# Fallback for the (unlikely) case that mod_rewrite is unavailable.
<IfModule mod_alias.c>
  RedirectMatch 404 "/\.(git|github|hg|svn|env|htaccess|htpasswd|thumbnail|DS_Store|idea|dart_tool|metadata)(/|$)"
</IfModule>

# Caching is configured in dist/.htaccess (see wumbi_landing/htaccess.src);
# nothing is served from this directory directly.
